# Copy to ".env" in the repository root (gitignored). Read by `docker compose` and by the integration tests.
# Values are literal: no quotes or escaping needed.

# SA password for the container: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_PORT=1433

# Server the integration tests create their throw-away databases on. Leave it out to use SQL Server LocalDB.
LUUKYCANTIN_TEST_SQLSERVER=Server=127.0.0.1,1433;User ID=sa;Password=ChangeMe_Str0ng!;TrustServerCertificate=true;Connect Timeout=60
