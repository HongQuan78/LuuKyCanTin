<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SP01QuestPdf</RootNamespace>
    <!-- Throw-away spike, not part of LuuKyCanTin.slnx. The repo root uses central package
         management (Directory.Packages.props), so opt out here and declare versions directly. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\Tinos-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Tinos-Bold.ttf" />
    <EmbeddedResource Include="Fonts\Tinos-Italic.ttf" />
    <EmbeddedResource Include="Fonts\LICENSE" />
  </ItemGroup>

</Project>