<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuuKyCanTin.Application\LuuKyCanTin.Application.csproj" />
    <ProjectReference Include="..\LuuKyCanTin.Domain\LuuKyCanTin.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LuuKyCanTin.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so printing never depends on fonts installed on a workstation; Tinos is Apache 2.0. -->
    <EmbeddedResource Include="Reports\Fonts\Tinos-Regular.ttf" />
    <EmbeddedResource Include="Reports\Fonts\Tinos-Bold.ttf" />
    <EmbeddedResource Include="Reports\Fonts\Tinos-Italic.ttf" />
    <EmbeddedResource Include="Reports\Fonts\LICENSE" />
  </ItemGroup>

</Project>
