# Copy this file to ".env" next to LuuKyCanTin.WinForms.exe (for development: in this project folder,
# it is copied to the output on build). ".env" is gitignored: never commit it.
#
# Format: KEY=VALUE, one per line. Values are literal, so backslashes need no escaping.
# A real environment variable with the same name overrides the value here.

ConnectionStrings__LuuKyCanTin=Server=.\SQLEXPRESS;Database=LuuKyCanTin;Integrated Security=true;TrustServerCertificate=true

# Development machine with the docker-compose SQL Server (use 127.0.0.1: WSL does not relay SQL over ::1):
# ConnectionStrings__LuuKyCanTin=Server=127.0.0.1,1433;Database=LuuKyCanTin;User ID=sa;Password=<MSSQL_SA_PASSWORD from the root .env>;TrustServerCertificate=true

# Development machine with LocalDB:
# ConnectionStrings__LuuKyCanTin=Server=(localdb)\MSSQLLocalDB;Database=LuuKyCanTin;Integrated Security=true;TrustServerCertificate=true
